# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# loop artefacts
shots/
verdict-*.json
test-results/
playwright-report/

# Loop working state: captures are large and regenerated every cycle;
# baselines are tracked, run artefacts are not.
shots/best/
shots/candidate/
shots/compare/
.loop/*
!.loop/copy-baseline.txt
!.loop/tests-baseline.txt
test-results/

# Live preview worktrees
.preview/

# Reference videos: source material, kept locally. Several exceed GitHub's
# 100MB hard file limit (Claryo - Interactive functionality.mov is 114MB), so
# committing them would break pushes outright. The extracted frame strips in
# design-refs/strips/ are what the loop actually reads, and those ARE tracked.
design-refs/*.mov
design-refs/*.mp4
design-refs/*.MOV
design-refs/*.MP4
.work/
.burst/
